{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/paintings/[id]",
      "regex": "^/paintings/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/paintings/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/aboutme",
      "regex": "^/aboutme(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/aboutme(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/illustrations",
      "regex": "^/illustrations(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/illustrations(?:/)?$"
    },
    {
      "page": "/journal",
      "regex": "^/journal(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/journal(?:/)?$"
    },
    {
      "page": "/paintings",
      "regex": "^/paintings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/paintings(?:/)?$"
    },
    {
      "page": "/snail",
      "regex": "^/snail(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/snail(?:/)?$"
    },
    {
      "page": "/video",
      "regex": "^/video(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/video(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}